{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node --experimental-strip-types --no-warnings=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\""
          }
        ]
      }
    ]
  }
}
