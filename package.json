{
  "name": "pi-autoresearch",
  "version": "2.0.0",
  "type": "module",
  "description": "Autonomous experiment loop for pi — run, measure, keep or discard. Inspired by karpathy/autoresearch.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "autoresearch",
    "experiment",
    "optimization",
    "benchmark",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "David Cortés <477473+davebcn87@users.noreply.github.com>",
  "homepage": "https://github.com/davebcn87/pi-autoresearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davebcn87/pi-autoresearch.git"
  },
  "bugs": {
    "url": "https://github.com/davebcn87/pi-autoresearch/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "hooks",
    "bin",
    "commands",
    ".claude-plugin",
    ".mcp.json",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/core/*.test.mjs tests/mcp/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@sinclair/typebox": "^0.34.41",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "bin": {
    "autoresearch-mcp": "./bin/autoresearch-mcp.mjs"
  }
}
